static func pick(category: String, rng: RandomNumberGenerator, used: Array) -> Array:
	## [단어, 주제]
	var cat := category
	if cat.is_empty():
		cat = CATEGORIES[rng.randi() % CATEGORIES.size()]
	var pool: Array = (WORDS[cat] as Array).filter(func(w: String) -> bool: return not used.has(w))
	if pool.is_empty():
		pool = WORDS[cat]
	return [pool[rng.randi() % pool.size()], cat]


## 글자 수 힌트 ("3글자")
static func hint(word: String) -> String:
	var n := 0
	for ch in word:
		if ch != " ":
			n += 1
	return "%d글자" % n
